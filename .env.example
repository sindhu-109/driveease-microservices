# Copy values into your local process environment; do not commit real secrets.
# Use the same 32+ byte JWT signing value in the user, vehicle, and booking services.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Set the same random 32+ character value for vehicle and booking services.
INTERNAL_SERVICE_SECRET=replace-with-a-different-random-internal-secret
# Existing local PostgreSQL database credentials.
DB_USERNAME=your-local-database-user
DB_PASSWORD=your-local-database-password
